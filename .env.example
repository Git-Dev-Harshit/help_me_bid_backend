# ===========================================================================
# IPO Tracker - environment configuration
# Copy to .env and adjust.  NEVER commit a real .env file.
# ===========================================================================

# --- Application ----------------------------------------------------------
# APP_ENV: development | staging | production
# In production, debug output and /docs exposure are governed by APP_ENV.
APP_ENV=development
APP_NAME=IPO Tracker
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
# json (production) | console (human readable, nicer for local dev)
LOG_FORMAT=console
# Expose /docs, /redoc, /openapi.json. Defaults to false when APP_ENV=production.
DOCS_ENABLED=true

# --- Database -------------------------------------------------------------
# Points at the PostgreSQL server running on the HOST machine (no database
# container). From inside a container the host is `host.docker.internal`.
# The async driver (asyncpg) is required; Alembic uses the same one.
#
# The `ipo_tracker` database is created automatically on first start if it does
# not exist, so no manual `CREATE DATABASE` is needed.
#
# Running the app outside Docker? Use `localhost` instead of
# `host.docker.internal`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/ipo_tracker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Security / JWT -------------------------------------------------------
# REQUIRED. Generate with:  openssl rand -hex 32
# The app refuses to start in production while this is left at the default.
JWT_SECRET_KEY=change-me-please-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=ipo-tracker

# Default region used to normalise phone numbers entered without a +country code.
DEFAULT_PHONE_REGION=IN
# Minimum password length enforced at registration.
PASSWORD_MIN_LENGTH=8

# --- CORS -----------------------------------------------------------------
# Comma-separated. Use explicit origins in production; "*" is dev-only.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# --- Rate limiting (in-process, per API container) ------------------------
RATE_LIMIT_ENABLED=true
# Applies to unauthenticated auth endpoints (login/register).
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Scraper --------------------------------------------------------------
SCRAPER_ENABLED=true

# Daily scrape windows (start times, in APP_TIMEZONE). Each run fires at a
# uniformly RANDOM moment inside [start, start + JITTER), re-rolled every day,
# so the request pattern is not perfectly periodic.
# The default gives three scrapes a day: 09:00-09:30, 14:00-14:30, 20:00-20:30.
SCRAPER_SCHEDULE_TIMES=09:00,14:00,20:00
SCRAPER_SCHEDULE_JITTER_MINUTES=30

# Only used when SCRAPER_SCHEDULE_TIMES is left empty, which switches the
# scraper back to fixed-interval mode.
SCRAPER_INTERVAL_MINUTES=30

# With only three runs a day, a single failure leaves data stale for hours, so
# a failed run schedules one retry this many minutes later (0 disables it).
SCRAPER_FAILURE_RETRY_MINUTES=20

# Scrape once at start-up, but only when there is no IPO data yet, so a fresh
# install is populated immediately without re-scraping on every restart.
SCRAPER_RUN_ON_STARTUP_IF_EMPTY=true

SCRAPER_REPORT_ID=331
SCRAPER_PAGE_URL=https://www.investorgain.com/report/ipo-gmp-live/331/
SCRAPER_API_BASE_URL=https://webnodejs.investorgain.com
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_BACKOFF_SECONDS=2
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
# Abort persistence when parser confidence drops below this (0.0 - 1.0).
SCRAPER_MIN_CONFIDENCE=0.5
# Store the raw payload for: always | on_failure | never
SCRAPER_RAW_RETENTION_MODE=on_failure
# Delete raw payloads older than this many days (0 disables cleanup).
SCRAPER_RAW_RETENTION_DAYS=14
# Record a per-IPO snapshot row whenever tracked values change.
SCRAPER_SNAPSHOTS_ENABLED=true

# --- Notifications --------------------------------------------------------
NOTIFICATION_ENABLED=true
# How often the worker evaluates notification rules.
NOTIFICATION_INTERVAL_MINUTES=15
# Active provider: log | fcm | webpush
NOTIFICATION_PROVIDER=log
# Quiet hours in APP_TIMEZONE - no notifications sent outside this window.
NOTIFICATION_WINDOW_START_HOUR=8
NOTIFICATION_WINDOW_END_HOUR=22
# Drop undelivered notifications older than this (avoids sending stale alerts).
NOTIFICATION_MAX_AGE_MINUTES=60

# --- Firebase Cloud Messaging (optional; only when NOTIFICATION_PROVIDER=fcm)
# Absolute path inside the container to the service-account JSON.
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=

# --- Web Push / VAPID (optional; only when NOTIFICATION_PROVIDER=webpush) --
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
